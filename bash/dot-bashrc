############################
# ~/.bashrc
# [HP] configured by Hermann
############################

# prompt
PS1='[\u@\h \W]\$ '

# If not running interactively, don't do anything
[[ $- != *i* ]] && return

# colors for various console commands
alias grep='grep --color=always'

# replace ls by eza
alias ls='eza --group-directories-first --icons'
alias ll='eza -la --git --group-directories-first --icons'
alias llm='eza -la --git --icons --sort=modified'
alias lt='eza -a --tree -L2 --group-directories-first --icons'

# update packages (keyring first) and other stuff
alias up='paru -Sy --needed archlinux-keyring && paru -Su && pacdiff -s && tldr -u'

# Kwin debug window, e.g. to check Wayland / XWayland windows
alias kwin-debug='qdbus6 org.kde.KWin /KWin org.kde.KWin.showDebugConsole'
