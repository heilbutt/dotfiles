############################
# ~/.bashrc
# [HP] configured by Hermann
############################

# Prompt
PS1='[\u@\h \W]\$ '

# If not running interactively, don't do anything
[[ $- != *i* ]] && return

# load fragments from .bashrc.d directory, which are usually placed there using GNU stow
# [[ -f $f ]] is a guard to avoid errors on empty directory
for f in "$HOME"/.bashrc.d/*.bash; do
  [[ -f $f ]] && source "$f"
done
unset f
